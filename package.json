{
  "name": "kontur",
  "version": "0.3.1",
  "description": "Единое рабочее место для двух изолированных контуров",
  "main": "./out/main/index.js",
  "author": "",
  "homepage": "https://github.com/anger1989/kontur-app",
  "repository": {
    "type": "git",
    "url": "https://github.com/anger1989/kontur-app.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dist:mac": "npm run build && electron-builder --mac --arm64 --config electron-builder.yml",
    "dist:linux": "npm run build && electron-builder --linux --x64 --config electron-builder.yml -c.npmRebuild=false",
    "dist": "npm run dist:mac && electron-builder --linux --x64 --config electron-builder.yml -c.npmRebuild=false",
    "fetch:snx": "bash scripts/fetch-snx-rs.sh",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@daypicker/react": "^10.0.2",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "better-sqlite3": "^13.0.3",
    "imapflow": "^2.2.1",
    "node-pty": "^1.1.0",
    "react-use-measure": "^2.1.7",
    "rrule": "^2.8.1",
    "undici": "^7.17.0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.9.0",
    "@codemirror/lang-markdown": "^6.4.0",
    "@codemirror/language": "^6.11.3",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.39.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/golos-text": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.2.8",
    "@fontsource/ibm-plex-serif": "^5.2.8",
    "@lezer/highlight": "^1.2.5",
    "@ridemountainpig/svgl-react": "^1.0.18",
    "@swc/core": "^1.15.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.49.0",
    "motion": "^14.0.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-big-calendar": "^1.20.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "simplex-noise": "^4.0.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
